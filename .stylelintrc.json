{
  "$schema": "https://json.schemastore.org/stylelintrc",
  "extends": ["stylelint-config-standard"],
  "customSyntax": "postcss-scss",
  "rules": {
    "color-hex-case": "lower",
    "color-hex-length": "short",
    "selector-class-pattern": "^mz-[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*(__[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*)?(--[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*)?$",
    "custom-property-pattern": "^mz-(color|font|space|radius|shadow|transition|z|breakpoint|container|btn|badge|input|chip|menu|signature)-[a-z0-9-]+$",
    "declaration-property-value-allowed-list": {
      "color": ["/^var\\(--mz-color-/", "/^var\\(--mz-(espresso|coffee|caramel|cream|ink|line|sage|amber|steel|danger)-/", "inherit", "transparent", "currentcolor"],
      "background-color": ["/^var\\(--mz-color-/", "/^var\\(--mz-(espresso|coffee|caramel|cream|ink|line|sage|amber|steel|danger)-/", "inherit", "transparent"],
      "background": ["/^var\\(--mz-color-/", "/^var\\(--mz-(espresso|coffee|caramel|cream|ink|line|sage|amber|steel|danger)-/", "inherit", "transparent", "/^linear-gradient/", "/^radial-gradient/"],
      "border-color": ["/^var\\(--mz-color-/", "/^var\\(--mz-(espresso|coffee|caramel|cream|ink|line|sage|amber|steel|danger)-/", "inherit", "transparent"],
      "font-family": ["/^var\\(--mz-font-/", "inherit"],
      "font-size": ["/^var\\(--mz-font-size-/", "/^clamp\\(/", "inherit"],
      "font-weight": ["/^var\\(--mz-font-weight-/", "inherit"],
      "line-height": ["/^var\\(--mz-line-height-/", "inherit"],
      "letter-spacing": ["/^var\\(--mz-letter-spacing-/", "inherit"],
      "padding": ["/^var\\(--mz-space-/", "/^var\\(--mz-(btn|badge|input|chip|container)-padding-/", "inherit"],
      "gap": ["/^var\\(--mz-space-/", "inherit"],
      "margin": ["/^var\\(--mz-space-/", "inherit"],
      "border-radius": ["/^var\\(--mz-radius-/", "/^var\\(--mz-(btn|badge|input|chip|menu|signature)-radius$/", "inherit"],
      "box-shadow": ["/^var\\(--mz-shadow-/", "inherit"],
      "transition": ["/^var\\(--mz-transition-/", "/^var\\(--mz-ease$/", "inherit"],
      "z-index": ["/^var\\(--mz-z-/", "inherit"],
      "height": ["/^var\\(--mz-(btn|badge|input|chip)-height-/", "inherit"],
      "width": ["/^var\\(--mz-container-max-width$/", "inherit"],
      "max-width": ["/^var\\(--mz-container-max-width$/", "inherit"],
      "aspect-ratio": ["/^var\\(--mz-(menu-card|signature)-aspect-ratio$/", "inherit"]
    },
    "declaration-property-value-disallowed-list": {
      "color": ["/^#[0-9a-f]{3,8}$/i", "/^rgb/", "/^hsl/"],
      "background-color": ["/^#[0-9a-f]{3,8}$/i", "/^rgb/", "/^hsl/"],
      "background": ["/^#[0-9a-f]{3,8}$/i", "/^rgb/", "/^hsl/"],
      "border-color": ["/^#[0-9a-f]{3,8}$/i", "/^rgb/", "/^hsl/"],
      "font-family": ["/^(Fraunces|Plus Jakarta Sans|Georgia|Segoe UI|system-ui|sans-serif)$/"],
      "font-size": ["/^\\d+(\\.\\d+)?(px|rem|em)$/"],
      "font-weight": ["/^\\d+$/"],
      "padding": ["/^\\d+(\\.\\d+)?(px|rem|em)$/"],
      "gap": ["/^\\d+(\\.\\d+)?(px|rem|em)$/"],
      "margin": ["/^\\d+(\\.\\d+)?(px|rem|em)$/"],
      "border-radius": ["/^\\d+(\\.\\d+)?(px|rem|em)$/"],
      "box-shadow": ["/^rgba?\\(/", "/^\\d+px \\d+px/"],
      "z-index": ["/^\\d+$/"],
      "height": ["/^\\d+px$/"],
      "max-width": ["/^\\d+px$/"]
    },
    "function-disallowed-list": ["rgba", "rgb", "hsl", "hsla"],
    "unit-allowed-list": ["px", "rem", "em", "%", "vw", "vh", "ch", "fr", "deg"],
    "selector-pseudo-class-no-unknown": [true, { "ignorePseudoClasses": ["global", "local"] }],
    "at-rule-no-unknown": [true, { "ignoreAtRules": ["tailwind", "apply", "layer", "variants", "responsive", "screen"] }]
  },
  "ignoreFiles": ["**/node_modules/**", "**/design-tokens.css", "**/magezz.css"]
}
